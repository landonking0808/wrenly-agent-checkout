# Copy to .env (run.sh does this for you). Never commit .env.

# --- PayPal (sandbox) -------------------------------------------------------
# From https://developer.paypal.com/dashboard/applications/sandbox -> your app -> Client ID / Secret.
# Leave both empty to run with the built-in mock PayPal.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Optional: set to 1 to force the mock even when keys are present (tests do this).
MOCK_PAYPAL=
# Optional: webhook id from your sandbox app's Webhooks section, to verify webhook signatures.
PAYPAL_WEBHOOK_ID=
# The sandbox *personal* account email that receives crew payouts (Payouts API receiver).
CREW_PAYPAL_EMAIL=
# Public base URL used for PayPal return/cancel URLs.
PUBLIC_URL=http://localhost:8000

# --- AI (Google Gemini) -----------------------------------------------------
# Free key: https://aistudio.google.com/apikey . Leave empty to use the deterministic offline agent.
GEMINI_API_KEY=
# Comma-separated, tried in order (fallback on overload).
GEMINI_MODEL=gemini-3.5-flash,gemini-2.5-flash,gemini-3.1-flash-lite
# Set to 1 to force the offline agent even with a key.
WRENLY_OFFLINE_AI=0

# --- Ops --------------------------------------------------------------------
# Optional shared secret required (header x-ops-token) for approvals and payout/void buttons.
OPS_TOKEN=
